<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [ initial_grass current_grass sheep-gain-from-food wolf-gain-from-food]  ;

; Sheep and wolves are both breeds of turtles
breed [ sheep a-sheep ]  ; sheep is its own plural, so we use "a-sheep" as the singular
breed [ wolves wolf ]

turtles-own [ energy ]       ; both wolves and sheep have energy
patches-own [ countdown ]    ; time the patch waits to regrow and be edible again

to setup
  clear-all

;;;;;;;  set up patches
  ask patches   [
    set pcolor brown
  ]

  let total_patches count patches
  set initial_grass total_patches / 2

  ask n-of initial_grass  patches   [
    set pcolor green
  ]

  ask patches with [pcolor = green]  [
    set countdown grass-regrowth-time
  ]

  ask patches with [pcolor = brown][
    set countdown random grass-regrowth-time ; initialize grass regrowth clocks randomly for brown patches
  ]

  set current_grass count patches with [pcolor = green]


;;;;;;;  set up sheep
  create-sheep initial-number-sheep [ ; create the sheep, then initialize their variables
    set shape  "sheep"
    set color white
    set size 1.5  ; easier to see
    set sheep-gain-from-food 4
    set energy random (sheep-gain-from-food) ; each are born with different energy level
    setxy random-xcor random-ycor
  ]

 ;;;;;;;  set up wolves
  create-wolves initial-number-wolves [  ; create the wolves, then initialize their variables
    set shape "wolf"
    set color black
    set size 2  ; easier to see
    set wolf-gain-from-food sheep-gain-from-food * 3
    set energy random (wolf-gain-from-food)
    setxy random-xcor random-ycor
  ]

  reset-ticks

end

to go

  if not any? turtles [stop] ; stop the model if there are no wolves nor sheep

  ask sheep  [
    wander
    reduce-energy; sheep lose energy as they move
    eat-grass  ; sheep eat grass (if available at their location)
    timeToDie ; sheep die from starvation (no energy left)
    reproduce-sheep  ; sheep reproduce at a random rate governed by a slider
  ]

  ask wolves [
    wander
    reduce-energy ; wolves lose energy as they move
    eat-sheep ; wolves eat (if available at their location)
    timeToDie ; wolves die from starvation (no energy left)
    reproduce-wolves ; wolves reproduce at a random rate governed by a slider
  ]

  ask patches [
    re-grow-grass
  ]

  set current_grass count patches with [pcolor = green] ; for reporter
  tick

end

;;;;turtle procedures (i.e. both wolf and sheep procedure)
to wander
  rt random 360
  fd 1
end

to reduce-energy
  set energy energy - 1
end

to timeToDie
   if energy < 0 [ die ]
end

;;;;sheep-only procedures
to eat-grass
  if pcolor = green [
    set pcolor brown
    set energy energy + sheep-gain-from-food  ; sheep eat grass and increase their energy
  ]
end

to reproduce-sheep
  if random-float 100 < sheep-reproduce [  ; throw "dice" to see if you will reproduce
    set energy (energy / 2)                ; divide energy between parent and offspring
    hatch 1 [                      ; hatch offspring, which inherits  half the energy of mother
      rt random-float 360 fd 1 ]   ; hatched offspring moves forward 1 step
  ]
end


;;;;wolves-only procedures
to reproduce-wolves
  if random-float 100 < wolf-reproduce [  ; throw "dice" to see if you will reproduce
    set energy (energy / 2)               ; share your energy with offspring
    hatch 1 [ rt random-float 360 fd 1 ]  ; hatched offspring moves forward 1 step
  ]
end

to eat-sheep
  let prey one-of sheep-here                    ; grab a random sheep (which is here in my patch)
  if prey != nobody  [                          ; did we get one? if so,
    ask prey [ die ]                            ; kill it, and...
    set energy energy + wolf-gain-from-food     ; get energy from eating
  ]
end


;;;;patches-only procedures
to re-grow-grass

  if pcolor = brown [ ; if you have not food
    ifelse countdown <= 0 ; if your clock is zero or less
      [ set pcolor green ; become food
        set countdown grass-regrowth-time ]  ; restart clock
      [ set countdown countdown - 1 ] ; if you are not food and clock greater than zero
  ]

end


;;;;REPORTERS
to-report land_with_grass
  report 100 * count patches with[pcolor = green] / count patches
end





; Copyright 1997 Uri Wilensky.
; See Info tab for full copyright and license.]]></code>
